---
const platforms = ["Airbnb", "Superhost", "Agoda"];
const socials = [
    { name: "Facebook", label: "f", href: "#" },
    { name: "Instagram", label: "ig", href: "#" },
    { name: "TikTok", label: "tt", href: "#" },
];
---

<footer class="bg-[#f7f1e7] px-4 py-12 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-6xl">
        <div class="grid gap-10 text-sm text-[#687064] sm:grid-cols-2 lg:grid-cols-[1.1fr_.9fr_1.15fr_.85fr]">
            <div>
                <p class="font-highlight text-3xl font-bold text-[#26332d]">
                    The Resort
                </p>
                <p class="mt-4 max-w-sm leading-6">
                    A countryside retreat for nature stays, events, and dining
                    near the mountains.
                </p>

                <div class="mt-6 flex flex-wrap gap-2">
                    {
                        platforms.map((platform) => (
                            <span class="rounded-full border border-[#d8cfbd] bg-white px-4 py-2 text-xs font-bold uppercase tracking-[.14em] text-[#26332d] shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-[#7c8351] hover:bg-[#fbf8f0] hover:shadow-md">
                                {platform}
                            </span>
                        ))
                    }
                </div>
            </div>

            <div>
                <p class="font-bold uppercase tracking-[.18em] text-[#26332d]">
                    Business Hours
                </p>
                <div class="mt-4 grid gap-5 leading-6">
                    <div>
                        <p class="font-bold text-[#26332d]">Day Tour</p>
                        <p>Sunday-Monday</p>
                        <p>7am - 7pm</p>
                    </div>
                    <div>
                        <p class="font-bold text-[#26332d]">Overnight</p>
                        <p>Sunday-Tuesday</p>
                        <p>7pm - 7am</p>
                    </div>
                </div>
            </div>

            <div>
                <p class="font-bold uppercase tracking-[.18em] text-[#26332d]">
                    Get in touch
                </p>
                <address class="mt-4 not-italic leading-6">
                    24 Meadow Lane, Willow Cove<br />
                    Northshore Province,<br />
                    Philippines 4000
                </address>
                <div class="mt-5 grid gap-2">
                    <a href="tel:+639175550184" class="font-semibold text-[#26332d] transition duration-300 hover:text-[#7c8351]">
                        S: +639175550184
                    </a>
                    <a href="tel:+639195550286" class="font-semibold text-[#26332d] transition duration-300 hover:text-[#7c8351]">
                        G: +639195550286
                    </a>
                    <a
                        href="mailto:stay@theresort.example"
                        class="break-words font-semibold text-[#26332d] transition duration-300 hover:text-[#7c8351]"
                    >
                        stay@theresort.example
                    </a>
                </div>
            </div>

            <div>
                <p class="font-bold uppercase tracking-[.18em] text-[#26332d]">
                    Social
                </p>
                <div class="mt-4 flex gap-3">
                    {
                        socials.map((social) => (
                            <a
                                href={social.href}
                                aria-label={social.name}
                                class="flex h-11 w-11 items-center justify-center rounded-full bg-[#26332d] text-xs font-bold uppercase text-white shadow-sm transition duration-300 hover:-translate-y-0.5 hover:scale-105 hover:bg-[#7c8351] hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#7c8351]"
                            >
                                {social.label}
                            </a>
                        ))
                    }
                </div>

                <div class="mt-8">
                    <p class="font-bold text-[#26332d]">Explore</p>
                    <div class="mt-3 grid gap-2">
                        <a href="#rooms" class="transition duration-300 hover:translate-x-1 hover:text-[#26332d]">Rooms</a>
                        <a href="#dining" class="transition duration-300 hover:translate-x-1 hover:text-[#26332d]">Dining</a>
                        <a href="#events" class="transition duration-300 hover:translate-x-1 hover:text-[#26332d]">Events</a>
                        <a href="#amenities" class="transition duration-300 hover:translate-x-1 hover:text-[#26332d]">Amenities</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-10 border-t border-[#d8cfbd] pt-6 text-xs text-[#687064]">
            <p>© The Resort. All rights reserved.</p>
        </div>
    </div>
</footer>
